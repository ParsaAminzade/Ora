{
  "manifest_version": 3,
  "name": "اورآ (Ora) · تب شخصی",
  "short_name": "Ora",
  "version": "2.4.2",
  "description": "صفحه‌ی تب جدید شخصی: ویجت‌های قابل چیدمان، تقویم شمسی، تسک‌ها و پس‌زمینه‌ی دلخواه. بدون تبلیغ و ردیابی.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "unlimitedStorage",
    "favicon",
    "declarativeNetRequestWithHostAccess",
    "identity",
    "downloads"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://www.googleapis.com/*",
    "https://api.ganjoor.net/*",
    "https://suggestqueries.google.com/*",
    "https://duckduckgo.com/*",
    "https://api.bing.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "اورآ"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src * data: blob:; font-src * data:; media-src * data: blob:; connect-src *; worker-src blob: 'self'; default-src 'self'"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "key": "",
  "sandbox": {
    "pages": [
      "sandbox.html",
      "bgframe.html"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
