<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اورآ" Width="560" Height="470" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#EFE9DD"/>
    <SolidColorBrush x:Key="Dim" Color="#9C978D"/>
    <SolidColorBrush x:Key="Gold" Color="#E3BD7A"/>
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="#1A140B"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="14" Padding="22,10">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#F6DCAA" Offset="0"/>
                  <GradientStop Color="#E3BD7A" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect><DropShadowEffect Color="#E3BD7A" BlurRadius="18" ShadowDepth="3" Opacity="0.28"/></Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.9"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="60" CenterY="20"/></Setter.Value></Setter></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Quiet" TargetType="Button">
      <Setter Property="Foreground" Value="#E3BD7A"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="14" Padding="16,9" BorderThickness="1" BorderBrush="#55E3BD7A" Background="#0DFFFFFF">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Close" TargetType="Button">
      <Setter Property="Foreground" Value="#9C978D"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="12" Width="34" Height="34" Background="Transparent">
              <TextBlock Text="✕" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="22">
    <!-- the card: a dark glass with a lit top edge, a gold hairline and a soft, layered shadow -->
    <Border x:Name="Card" CornerRadius="28" BorderThickness="1">
      <Border.Effect><DropShadowEffect Color="Black" BlurRadius="36" ShadowDepth="10" Opacity="0.6" Direction="270"/></Border.Effect>
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#99E3BD7A" Offset="0"/>
          <GradientStop Color="#1AFFFFFF" Offset="0.35"/>
          <GradientStop Color="#0DFFFFFF" Offset="0.7"/>
          <GradientStop Color="#55E3BD7A" Offset="1"/>
        </LinearGradientBrush>
      </Border.BorderBrush>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#1C1E27" Offset="0"/>
          <GradientStop Color="#12141B" Offset="0.55"/>
          <GradientStop Color="#0C0D12" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <!-- textures: a warm glow in one corner, a cool one in the other, and the little pressed-glass cells -->
    <Border CornerRadius="28" IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="0.88,0.02" GradientOrigin="0.88,0.02" RadiusX="0.75" RadiusY="0.6">
          <GradientStop Color="#33E3BD7A" Offset="0"/>
          <GradientStop Color="#00E3BD7A" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border CornerRadius="28" IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="0.05,1" GradientOrigin="0.05,1" RadiusX="0.7" RadiusY="0.55">
          <GradientStop Color="#1F7FD3C8" Offset="0"/>
          <GradientStop Color="#007FD3C8" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border CornerRadius="28" IsHitTestVisible="False" Opacity="0.05">
      <Border.Background>
        <DrawingBrush TileMode="Tile" Viewport="0,0,7,7" ViewportUnits="Absolute" Stretch="None">
          <DrawingBrush.Drawing>
            <DrawingGroup>
              <GeometryDrawing Geometry="M0,0 L7,0 L3.5,3.5 Z" Brush="#FFFFFF"/>
              <GeometryDrawing Geometry="M7,0 L7,7 L3.5,3.5 Z" Brush="#80FFFFFF"/>
              <GeometryDrawing Geometry="M0,7 L7,7 L3.5,3.5 Z" Brush="#000000"/>
              <GeometryDrawing Geometry="M0,0 L0,7 L3.5,3.5 Z" Brush="#40FFFFFF"/>
            </DrawingGroup>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </Border.Background>
    </Border>
    <!-- lit top edge -->
    <Border CornerRadius="28,28,0,0" Height="60" VerticalAlignment="Top" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#14FFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Grid Margin="28,18,28,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- header: Ora's eye, its name, close -->
      <Grid x:Name="Head" Background="Transparent" Height="44">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="30" Height="30">
            <Ellipse Stroke="#E3BD7A" StrokeThickness="3.2"/>
            <Ellipse x:Name="Pupil" Width="9" Height="9" Fill="#FFF1D6">
              <Ellipse.RenderTransform><TranslateTransform X="2" Y="-2"/></Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <TextBlock Text="اورآ" Foreground="{StaticResource Ink}" FontSize="21" Margin="12,0,0,0" VerticalAlignment="Center"/>
          <Border x:Name="Badge" CornerRadius="10" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="10,3" Margin="12,2,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="BadgeText" Foreground="{StaticResource Dim}" FontSize="12"/>
          </Border>
        </StackPanel>
        <Button x:Name="CloseBtn" Style="{StaticResource Close}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>

      <!-- page: working (download, copy) -->
      <Grid x:Name="PageWork" Grid.Row="1" Margin="0,22,0,0">
        <StackPanel VerticalAlignment="Top">
          <TextBlock x:Name="Title" Foreground="{StaticResource Ink}" FontSize="24" TextWrapping="Wrap"/>
          <TextBlock x:Name="Status" Foreground="{StaticResource Dim}" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="26"/>
          <Border x:Name="Track" CornerRadius="5" Height="10" Background="#1FFFFFFF" Margin="0,28,0,0">
            <Border x:Name="Bar" CornerRadius="5" HorizontalAlignment="Left" Width="0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#E3BD7A" Offset="0"/>
                  <GradientStop Color="#F6DCAA" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect><DropShadowEffect Color="#E3BD7A" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
            </Border>
          </Border>
          <TextBlock x:Name="Detail" Foreground="{StaticResource Dim}" FontSize="13" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button x:Name="DoneBtn" Style="{StaticResource Primary}" Content="بستن" Visibility="Collapsed" Margin="0,0,10,0"/>
          <Button x:Name="LogBtn" Style="{StaticResource Quiet}" Content="جزئیات"/>
        </StackPanel>
      </Grid>

      <!-- page: the log, for when you want to see exactly what happened -->
      <Grid x:Name="PageLog" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border CornerRadius="16" Background="#26000000" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="4">
          <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#C9C3B6"
                   FontSize="13" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" FlowDirection="RightToLeft"/>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
          <Button x:Name="BackBtn" Style="{StaticResource Quiet}" Content="برگشت"/>
          <Button x:Name="CopyLogBtn" Style="{StaticResource Quiet}" Content="کپی گزارش" Margin="10,0,0,0"/>
        </StackPanel>
      </Grid>

      <!-- page: the guide, one step at a time, with a picture of exactly where to click -->
      <Grid x:Name="PageGuide" Grid.Row="1" Margin="0,14,0,0" Visibility="Collapsed">
        <StackPanel VerticalAlignment="Top">
          <TextBlock x:Name="GTitle" Foreground="{StaticResource Ink}" FontSize="20" TextWrapping="Wrap"/>
          <!-- the picture: the browser's extensions page, drawn left-to-right like the real one -->
          <Border CornerRadius="14" Background="#202124" BorderBrush="#2EFFFFFF" BorderThickness="1" Height="112" Margin="0,12,0,0" FlowDirection="LeftToRight" ClipToBounds="True">
            <Canvas x:Name="Pic">
              <Border Canvas.Left="10" Canvas.Top="9" Width="440" Height="20" CornerRadius="10" Background="#35363A">
                <TextBlock x:Name="PicUrl" Text="chrome://extensions" FontFamily="Segoe UI" FontSize="11" Foreground="#9AA0A6" Margin="12,2,0,0"/>
              </Border>
              <TextBlock x:Name="PicTitle" Text="Extensions" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="#E8EAED" Canvas.Left="14" Canvas.Top="40"/>
              <TextBlock x:Name="PicDev" Text="Developer mode" FontFamily="Segoe UI" FontSize="12" Foreground="#E8EAED" Canvas.Left="320" Canvas.Top="42"/>
              <Border x:Name="Toggle" Canvas.Left="418" Canvas.Top="43" Width="26" Height="14" CornerRadius="7" Background="#5F6368">
                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left"/>
              </Border>
              <Border x:Name="LoadBtn" Canvas.Left="14" Canvas.Top="72" Height="26" CornerRadius="6" BorderBrush="#8AB4F8" BorderThickness="1" Padding="10,0" Visibility="Hidden">
                <TextBlock Text="Load unpacked" FontFamily="Segoe UI" FontSize="12" Foreground="#8AB4F8" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="PackBtn" Canvas.Left="130" Canvas.Top="72" Height="26" CornerRadius="6" BorderBrush="#5F6368" BorderThickness="1" Padding="10,0" Visibility="Hidden">
                <TextBlock Text="Pack extension" FontFamily="Segoe UI" FontSize="12" Foreground="#9AA0A6" VerticalAlignment="Center"/>
              </Border>
              <Ellipse x:Name="Ring" Stroke="#E3BD7A" StrokeThickness="3" Width="52" Height="34" Canvas.Left="405" Canvas.Top="33">
                <Ellipse.Effect><DropShadowEffect Color="#E3BD7A" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
              </Ellipse>
            </Canvas>
          </Border>
          <TextBlock x:Name="GText" Foreground="#D8D2C6" FontSize="14.5" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="25"/>
          <TextBlock x:Name="GState" Foreground="{StaticResource Dim}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button x:Name="GNext" Style="{StaticResource Primary}" Content="روشنش کردم"/>
          <Button x:Name="GPage" Style="{StaticResource Quiet}" Content="صفحه باز نشد" Margin="10,0,0,0"/>
          <Button x:Name="GCopy" Style="{StaticResource Quiet}" Content="کپی مسیر" Margin="10,0,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
